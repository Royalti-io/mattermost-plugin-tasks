{
    "id": "com.royalti.tasks",
    "name": "Tasks",
    "description": "Channel-scoped tasks with a Kanban board, reminders and an API for bots and agents.",
    "homepage_url": "https://github.com/Royalti-io/mattermost-plugin-tasks",
    "support_url": "https://github.com/Royalti-io/mattermost-plugin-tasks/issues",
    "icon_path": "assets/tasks-icon.svg",
    "min_server_version": "12.0.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "",
        "footer": "",
        "settings": [
            {
                "key": "UIAllowlist",
                "display_name": "UI allowlist (usernames)",
                "type": "text",
                "help_text": "Comma-separated usernames who see the Tasks UI. Empty means nobody. Used to limit exposure while the plugin is in development.",
                "default": "chinedumokerengwor"
            },
            {
                "key": "DisableReminders",
                "display_name": "Disable reminders",
                "type": "bool",
                "help_text": "Stops the scheduled due-date reminders and daily digests. Manual runs by an administrator still work.",
                "default": false
            }
        ]
    }
}
